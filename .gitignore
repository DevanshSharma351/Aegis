# Secrets. `.env.example` is deliberately NOT ignored: it carries key names and
# comments but no values, and without it nobody can tell what needs configuring.
.env

# Dependencies / build output
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/

# Foundry
contracts/out/
contracts/cache/
# NOTE: broadcast logs are governed by contracts/.gitignore, not here. Foundry
# ships a `!/broadcast` negation that overrides any rule set at this level, so a
# rule here would look effective and silently do nothing.

# Railgun engine state and Groth16 artifacts (regenerable, large)
.railgun/
railgun-sidecar/engine.db/
railgun-sidecar/artifacts/

# The simulator binary is ~26 MB; fetch it with scripts/fetch_simulator.sh
simulator/bin/

# Vendored dstack checkout, used only as a source for the simulator binary
dstack-sim/

# Local scratch
Microsoft/
prompt.txt
prompt_utf8.txt

# `tests/` was listed as scratch, which was wrong: it holds the cross-language
# integration suite that checks the enclave, the oracle and the contracts agree
# on the same encodings. Only its dependencies are ignored.
tests/node_modules/

# Session-key approval: NOT a secret (it is an enable signature, useless without
# SESSION_KEY_PRIVATE_KEY), but it is per-deployment and regenerable, so it is
# left untracked to avoid committing one deployment's blob into another's tree.
shared/config/session-key-approval.json

# Editor / agent tooling — local to a machine, not part of the project
.claude/
.vscode/
.idea/
