# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Broadcast logs. `run-latest.json` is kept deliberately: it is the deployment
# record for the live contracts, and lets anyone check the addresses in the
# README against the transactions that actually created them.
#
# The timestamped siblings are the same data for superseded deploys -- every
# redeploy adds another, all pointing at contracts that no longer matter.
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
/broadcast/**/run-[0-9]*.json

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
