# --- RPC ---------------------------------------------------------------------
# Read by: identity, railgun-sidecar, deploy scripts
ALCHEMY_API_KEY=                  # Sepolia RPC key
AEGIS_RPC_URL=                    # Optional: full RPC URL, overrides Alchemy.


# --- ERC-4337 ----------------------------------------------------------------
# Read by: identity
PIMLICO_API_KEY=                  # Bundler + paymaster. Without it no UserOperation can be submitted.

# --- Keys --------------------------------------------------------------------
#
# Read by: deploy scripts (host only, never a container)
DEPLOYER_PRIVATE_KEY=             # Deploys the contracts; becomes owner.
#
# Read by: bootstrap scripts (host only, never a container)
AEGIS_OWNER_PRIVATE_KEY=          # Owns the smart account, authorises the session key. Deliberately NOT passed to the identity container: submission signs with the session key alone.

#
# Read by: identity container
SESSION_KEY_PRIVATE_KEY=          # Signs rebalance UserOperations. Scoped to one selector, one target, zero value, ten times per day. See identity/src/clients.ts for the TEE key-derivation upgrade path.

#
# Read by: oracle container
AEGIS_ORACLE_PRIVATE_KEY=         # Signs on-chain attestations. This key alone
                                  # decides which enclave measurements the
                                  # protocol accepts.

# --- Oracle policy -----------------------------------------------------------
# Read by: oracle
AEGIS_REQUIRE_HARDWARE=false      # true => refuse to sign simulator quotes.
                                  # Set this before anything real depends on it.
AEGIS_MEASUREMENT_ALLOWLIST=      # Comma-separated 0x measurements the oracle
                                  # will sign for. Empty = sign for any build,
                                  # which is only correct during bootstrap.
AEGIS_DSTACK_VERIFIER_URL=        # dstack verifier service; required when
                                  # AEGIS_REQUIRE_HARDWARE is true.
AEGIS_ATTESTATION_TTL_S=900       # Signature lifetime. Bounds how long a leaked
                                  # proof stays usable.

# --- Enclave / TEE -----------------------------------------------------------
# Read by: enclave
AEGIS_ATTESTATION_SOURCE=simulator   # 'simulator' or 'hardware-tdx'. Surfaced
                                     # end-to-end so a simulator attestation is
                                     # never mistaken for a hardware one.
COINGECKO_API_KEY=                   # Optional demo key; raises rate limits.
# DSTACK_SIMULATOR_ENDPOINT is set by docker-compose to the shared socket path.
# On real TDX hardware, leave it unset and the SDK finds the guest agent socket.

# --- Railgun -----------------------------------------------------------------
# Read by: railgun-sidecar
RAILGUN_WALLET_MNEMONIC=          # 12/24 words. Controls the shielded balance.
RAILGUN_TEST_SIGNER_KEY=          # Public EOA that broadcasts and pays gas. It
                                  # learns nothing about the shielded amounts.
RAILGUN_POI_NODE_URL=             # Proof of Innocence aggregator.
                                  # REQUIRED to spend shielded funds on Sepolia:
                                  # shield and balance scans work without it,
                                  # unshield/swap/reshield cannot generate a
                                  # proof. See railgun-sidecar/README.md.
RAILGUN_ENGINE_DB_PATH=           # Defaults to /data/railgun in the container.
RAILGUN_VERBOSE=false

# --- Pipeline ----------------------------------------------------------------
AEGIS_SWAP_SELL_AMOUNT=1000000000000000   # 0.001 WETH, in base units.

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_ALCHEMY_API_KEY=      # Public-safe key for client-side reads.

# NOTE: contract addresses are NOT environment variables. They live in
# shared/config/deployed.json, written by the deploy script, so there is exactly
# one source of truth and no chance of .env drifting from the chain.
